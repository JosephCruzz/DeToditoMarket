# Backend
PORT=3000

# Base de datos (usa DB_URL o variables sueltas)
DB_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME
DB_HOST=HOST
DB_PORT=5432
DB_NAME=DB_NAME
DB_USER=USER
DB_PASSWORD=PASSWORD
DB_SSL=true

# CORS (separar por comas si hay múltiples)
CORS_ORIGINS=http://localhost:5173

# Frontend (Vite)
VITE_API_URL=http://localhost:3000
